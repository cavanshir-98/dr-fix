# Supabase Session Pooler for Render (IPv4) — Supabase → Connect → Session pooler
# Prefer port 5432 (Session). Port 6543 (Transaction) also works with prepareThreshold=0 in application.properties.

SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.vqhhguzjtkcahhtjllrs
SPRING_DATASOURCE_PASSWORD=

ADMIN_PASSWORD=change-me

# Booking notification email (same message as WhatsApp)
BOOKING_NOTIFICATION_EMAIL=drfixappliance@gmail.com
RESEND_FROM=DrFix <onboarding@resend.dev>

# Option 1 — Gmail App Password (Google Account → Security → App passwords)
SPRING_MAIL_PASSWORD=

# Option 2 — Resend (recommended): resend.com → API Keys → verify drfixappliance@gmail.com
# Copy .env.example → .env.local and paste your key. bootRun loads .env.local automatically.
RESEND_API_KEY=

# Option 3 — Brevo: brevo.com → API Keys
BREVO_API_KEY=
